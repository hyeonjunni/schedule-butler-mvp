# Copy this file to .env and fill local secrets.
# Never commit .env.

OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini

# Optional. Leave commented out for local JSON storage in .data/schedule-butler.json.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/schedule_butler
DATABASE_SSL=false

# Optional deployment metadata. Do not commit server passwords.
REMOTE_DB_HOST=
REMOTE_DB_USER=
REMOTE_DB_NAME=schedule_butler
